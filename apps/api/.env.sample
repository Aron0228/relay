POSTGRES_URL=postgres://postgres:postgres@localhost/relay

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

OAUTH_TRANSACTION_TTL_MINUTES=5
