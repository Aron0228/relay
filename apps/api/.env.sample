POSTGRES_URL=postgres://postgres:postgres@localhost/relay

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=10

OAUTH_TRANSACTION_TTL_MINUTES=5
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
OAUTH_EXCHANGE_TTL_SECONDS=60
GITHUB_OAUTH_CALLBACK_URI=http://localhost:3000/api/sessions/callback
# Approved client destinations after the server's GitHub callback.
OAUTH_WEB_REDIRECT_URI=http://localhost:4200/auth/callback
OAUTH_MOBILE_REDIRECT_URI=relay://auth/callback

GITHUB_WEBHOOK_SECRET=

WORKER_ENABLED=true
WORKER_QUEUE_NAME=relay-browser
# Local BullMQ consumer concurrency (per API instance)
WORKER_CONCURRENCY=2
# Shared limits across instances using the same queue and database
WORKER_GLOBAL_LIMIT=6
WORKER_WORKSPACE_LIMIT=3
# Optional workspace UUID -> positive integer overrides
WORKER_WORKSPACE_LIMITS={}
WORKER_LEASE_SECONDS=30
WORKER_TIMEOUT_SECONDS=120
WORKER_ACTION_DELAY_MS=1000
WORKER_EXAMPLE_URL=https://demo.playwright.dev/todomvc
# Defaults to apps/api/storage/worker-videos
WORKER_VIDEO_DIR=

AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=qwen3:8b
AI_API_KEY=
AI_ALLOWED_ORIGINS=https://academybugs.com
AI_MAX_TURNS=20
AI_MAX_TOOL_CALLS=40
AI_RUN_TIMEOUT_SECONDS=180
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_CONTEXT_CHARACTERS=80000
AI_MAX_OBSERVATION_CHARACTERS=12000

AI_REQUEST_MAX_ATTEMPTS=3
# Used to create an H.264 MP4 playback copy for browser/mobile compatibility.
WORKER_FFMPEG_PATH=ffmpeg

# Workspace avatar file storage
# WORKSPACE_AVATAR_DIR=./storage/workspace-avatars

# GitHub App API authentication.
GITHUB_APP_ID=
# Optional: preferred JWT issuer instead of GITHUB_APP_ID.
GITHUB_APP_CLIENT_ID=
# PEM
GITHUB_APP_PRIVATE_KEY=

# Retry stored issue_comment deliveries after queue/GitHub outages or process restarts.
ISSUE_REPRODUCTION_RECOVERY_ENABLED=true
ISSUE_REPRODUCTION_RECOVERY_SECONDS=5
ISSUE_REPRODUCTION_LEASE_SECONDS=120

# Single-use workspace-bound GitHub installation setup state (default 10 minutes).
GITHUB_INSTALLATION_STATE_TTL_SECONDS=600
